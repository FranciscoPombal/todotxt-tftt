{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run todotxt-tftt via uv",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "todotxt-tftt"
            ],
            "options": {
                "env": {
                    "TODO_SH": "todo.sh -d ${workspaceFolder}/test_files/todo.cfg"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
